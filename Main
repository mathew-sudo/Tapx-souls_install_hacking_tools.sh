#!/data/data/com.termux/files/usr/bin/bash

# Tapx-souls Advanced Security Tools Installer
# Enhanced version with better error handling and logging

set -e
LOG_FILE="$HOME/tapx-souls-install.log"
TOOLS_INSTALLED=0
TOTAL_TOOLS=0

# Color codes for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Create log file with proper permissions
touch "$LOG_FILE" && chmod 600 "$LOG_FILE"

# Function to display banner
show_banner() {
    clear
    echo -e "${PURPLE}"
    if command -v figlet >/dev/null 2>&1; then
        figlet -f slant "TAPX-SOULS" 2>/dev/null
    else
        echo "████████  █████  ██████  ██   ██      ███████  ██████  ██    ██ ██      ███████ "
        echo "   ██    ██   ██ ██   ██  ██ ██       ██      ██    ██ ██    ██ ██      ██      "
        echo "   ██    ███████ ██████    ███   █████ ███████ ██    ██ ██    ██ ██      ███████ "
        echo "   ██    ██   ██ ██       ██ ██             ██ ██    ██ ██    ██ ██           ██ "
        echo "   ██    ██   ██ ██      ██   ██       ███████  ██████   ██████  ███████ ███████ "
    fi
    echo -e "${NC}${CYAN}Advanced Termux Security Arsenal${NC}"
    echo -e "${YELLOW}=================================${NC}"
    echo ""
}

# Function to log messages
log_message() {
    local level=$1
    local message=$2
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$level] $message" >> "$LOG_FILE"
    
    case $level in
        "INFO")  echo -e "${BLUE}[INFO]${NC} $message" ;;
        "SUCCESS") echo -e "${GREEN}[SUCCESS]${NC} $message" ;;
        "WARNING") echo -e "${YELLOW}[WARNING]${NC} $message" ;;
        "ERROR") echo -e "${RED}[ERROR]${NC} $message" ;;
    esac
}

# Function to check if package is installed
is_installed() {
    pkg list-installed | grep -q "^$1/"
}

# Function to install package with error handling
install_package() {
    local package=$1
    local description=$2
    local optional=${3:-false}
    
    TOTAL_TOOLS=$((TOTAL_TOOLS + 1))
    
    if is_installed "$package"; then
        log_message "INFO" "$package is already installed"
        TOOLS_INSTALLED=$((TOOLS_INSTALLED + 1))
        return 0
    fi
    
    log_message "INFO" "Installing $package - $description"
    echo -ne "${BLUE}[INFO]${NC} Installing $package... "
    
    if pkg install -y "$package" >> "$LOG_FILE" 2>&1; then
        echo -e "${GREEN}✓${NC}"
        log_message "SUCCESS" "$package installed successfully"
        TOOLS_INSTALLED=$((TOOLS_INSTALLED + 1))
        return 0
    else
        if [ "$optional" = "true" ]; then
            echo -e "${YELLOW}⚠${NC} (optional package failed)"
            log_message "WARNING" "Optional package $package failed to install"
            return 0
        else
            echo -e "${RED}✗${NC}"
            log_message "ERROR" "Failed to install $package"
            return 1
        fi
    fi
}

# Function to check network connectivity
check_network() {
    log_message "INFO" "Checking network connectivity..."
    if ! ping -c 1 8.8.8.8 >/dev/null 2>&1; then
        log_message "ERROR" "No internet connection detected"
        echo -e "${RED}Error: Internet connection required${NC}"
        exit 1
    fi
    log_message "SUCCESS" "Network connectivity confirmed"
}

# Initialize
show_banner
log_message "INFO" "Starting Tapx-souls installation process"

# Check network connectivity
check_network

# Update and upgrade Termux packages
log_message "INFO" "Updating package repositories..."
echo -e "${BLUE}[INFO]${NC} Updating package repositories..."
if pkg update -y >> "$LOG_FILE" 2>&1 && pkg upgrade -y >> "$LOG_FILE" 2>&1; then
    log_message "SUCCESS" "Package repositories updated"
    echo -e "${GREEN}✓${NC} Package repositories updated"
else
    log_message "ERROR" "Failed to update package repositories"
    echo -e "${RED}✗${NC} Failed to update package repositories"
    exit 1
fi

# Install basic utilities
log_message "INFO" "Installing basic utilities..."
install_package "git" "Version control system"
install_package "wget" "File downloader"
install_package "curl" "Data transfer tool"
install_package "proot-distro" "Linux distribution manager"
install_package "termux-tools" "Termux utilities"
