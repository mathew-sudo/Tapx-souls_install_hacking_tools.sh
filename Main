    for package in "${python_packages[@]}"; do
        log_message "INFO" "Installing Python package: $package"
        pip install "$package" >> "$LOG_FILE" 2>&1 || log_message "WARNING" "Failed to install $package"
    done
fi

# Install password cracking tools
log_message "INFO" "Installing password security tools..."
install_package "hydra" "Network logon cracker" "true"
