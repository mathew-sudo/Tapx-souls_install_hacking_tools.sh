        <item name="android:colorAccent">@color/matrix_green</item>
        <item name="android:windowBackground">@color/matrix_black</item>
    </style>
</resources>
EOF
}

# Function to compile APK steps
compile_apk_steps() {
    local project_dir=$1
    local app_name=$2
    
    log_message "INFO" "Starting APK compilation steps for $app_name..."
    
    # Step 1: Generate R.java
    log_message "INFO" "Generating R.java..."
    aapt package -f -m \
        -S "$project_dir/res" \
        -M "$project_dir/AndroidManifest.xml" \
        -I "$ANDROID_HOME/platforms/android-33/android.jar" \
        -J "$project_dir/gen"
    
    # Step 2: Compile Java sources
    log_message "INFO" "Compiling Java sources..."
    javac -d "$project_dir/bin" \
        -classpath "$ANDROID_HOME/platforms/android-33/android.jar" \
        -sourcepath "$project_dir/src:$project_dir/gen" \
        $(find "$project_dir/src" "$project_dir/gen" -name "*.java")
    
    # Step 3: Convert to DEX
    log_message "INFO" "Converting to DEX format..."
    dx --dex --output="$project_dir/bin/classes.dex" "$project_dir/bin"
    
    # Step 4: Package resources
    log_message "INFO" "Packaging resources..."
    aapt package -f \
        -M "$project_dir/AndroidManifest.xml" \
        -S "$project_dir/res" \
        -I "$ANDROID_HOME/platforms/android-33/android.jar" \
        -F "$project_dir/bin/$app_name.unsigned.apk"
    
    # Step 5: Add DEX to APK
    log_message "INFO" "Adding DEX to APK..."
    cd "$project_dir/bin"
    aapt add "$app_name.unsigned.apk" classes.dex
    
    # Step 6: Align APK
    log_message "INFO" "Aligning APK..."
    zipalign -f 4 "$app_name.unsigned.apk" "$app_name.aligned.apk"
    
    # Step 7: Sign APK
    log_message "INFO" "Signing APK..."
    generate_keystore_if_needed
    apksigner sign --ks "$HOME/.tapx-souls-keystore.jks" \
        --ks-pass pass:tapxsouls123 \
        --out "$APK_OUTPUT_DIR/$app_name.apk" \
        "$app_name.aligned.apk"
    
    cd - > /dev/null
}

# Function to generate keystore if needed
generate_keystore_if_needed() {
    local keystore_path="$HOME/.tapx-souls-keystore.jks"
    
    if [ ! -f "$keystore_path" ]; then
        log_message "INFO" "Generating keystore for APK signing..."
        keytool -genkey -v \
            -keystore "$keystore_path" \
            -alias tapx-souls \
            -keyalg RSA \
            -keysize 2048 \
            -validity 10000 \
            -storepass tapxsouls123 \
            -keypass tapxsouls123 \
            -dname "CN=Tapx-souls, OU=Security, O=Tapx-souls, L=Unknown, S=Unknown, C=US"
    fi
}

# Function to create universal app compiler
create_universal_compiler() {
    log_message "INFO" "Creating universal app compiler script..."
    
    cat > "$COMPILER_DIR/tapx-compiler.sh" << 'EOF'
#!/bin/bash
# Tapx-souls Universal App Compiler

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILDS_DIR="$HOME/tapx-souls/builds"
APKS_DIR="$HOME/tapx-souls/apks"

show_usage() {
    echo "Tapx-souls Universal App Compiler"
    echo "Usage: $0 [OPTIONS] <command>"
    echo ""
    echo "Commands:"
    echo "  compile <app_name>     Compile an Android APK"
    echo "  build-all             Build all available apps"
    echo "  clean                 Clean build directories"
    echo "  list                  List available app templates"
    echo ""
    echo "Options:"
    echo "  -p, --package <name>  Package name (default: com.tapxsouls.app)"
    echo "  -v, --version <ver>   Version name (default: 1.0)"
    echo "  -c, --code <code>     Version code (default: 1)"
    echo "  -h, --help           Show this help message"
}

compile_app() {
    local app_name=$1
    local package_name=${2:-"com.tapxsouls.$(echo $app_name | tr '[:upper:]' '[:lower:]')"}
    local version_name=${3:-"1.0"}
    local version_code=${4:-1}
    
    echo "🔨 Compiling $app_name..."
    echo "📦 Package: $package_name"
    echo "🏷️  Version: $version_name ($version_code)"
    echo ""
    
    # Call the main compilation function
    source "$HOME/tapx-souls_install_hacking_tools.sh/Main"
    compile_android_apk "$app_name" "$package_name" "$version_code" "$version_name"
}

build_all_apps() {
    echo "🏗️  Building all Tapx-souls apps..."
    
    local apps=(
        "TapxNetworkScanner"
        "TapxWifiCracker" 
        "TapxPayloadGen"
        "TapxExploitKit"
        "TapxWebScanner"
        "TapxPhishingKit"
        "TapxOSINT"
        "TapxForensics"
    )
    
    for app in "${apps[@]}"; do
        compile_app "$app"
        echo ""
    done
    
    echo "✅ All apps compiled successfully!"
    echo "📁 APKs available in: $APKS_DIR"
}

clean_builds() {
    echo "🧹 Cleaning build directories..."
    rm -rf "$BUILDS_DIR"/*
    rm -rf "$APKS_DIR"/*
    echo "✅ Build directories cleaned"
}

list_templates() {
    echo "📱 Available app templates:"
    echo "  • TapxNetworkScanner - Network discovery and port scanning"
    echo "  • TapxWifiCracker - WiFi security testing"
    echo "  • TapxPayloadGen - Payload and shellcode generator"
    echo "  • TapxExploitKit - Exploitation framework"
    echo "  • TapxWebScanner - Web vulnerability scanner"
    echo "  • TapxPhishingKit - Social engineering toolkit"
    echo "  • TapxOSINT - Open source intelligence gathering"
    echo "  • TapxForensics - Mobile forensics and analysis"
}

# Parse command line arguments
PACKAGE_NAME=""
VERSION_NAME="1.0"
VERSION_CODE=1

while [[ $# -gt 0 ]]; do
    case $1 in
        -p|--package)
            PACKAGE_NAME="$2"
            shift 2
            ;;
        -v|--version)
            VERSION_NAME="$2"
            shift 2
            ;;
        -c|--code)
            VERSION_CODE="$2"
            shift 2
            ;;
        -h|--help)
            show_usage
            exit 0
            ;;
        compile)
            if [ -z "$2" ]; then
                echo "Error: App name required"
                show_usage
                exit 1
            fi
            APP_NAME="$2"
            PACKAGE_NAME=${PACKAGE_NAME:-"com.tapxsouls.$(echo $APP_NAME | tr '[:upper:]' '[:lower:]')"}
            compile_app "$APP_NAME" "$PACKAGE_NAME" "$VERSION_NAME" "$VERSION_CODE"
            exit 0
            ;;
        build-all)
            build_all_apps
            exit 0
            ;;
        clean)
            clean_builds
            exit 0
            ;;
        list)
            list_templates
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            show_usage
            exit 1
            ;;
    esac
done

show_usage
EOF

    chmod +x "$COMPILER_DIR/tapx-compiler.sh"
    
    # Create symlink for easy access
    ln -sf "$COMPILER_DIR/tapx-compiler.sh" "$HOME/../usr/bin/tapx-compiler"
    
    log_message "SUCCESS" "Universal compiler created: tapx-compiler"
}

# Enhanced app building function
build_tapx_souls_app() {
    log_message "INFO" "Building complete Tapx-souls Android application..."
    
    local app_dir="android-app"
    
    # Ensure Android development environment
    setup_android_environment
    
    # Create complete app structure if it doesn't exist
    if [ ! -d "$app_dir" ]; then
        log_message "INFO" "Creating Android app structure..."
        create_complete_app_structure
    fi
    
    cd "$app_dir"
    
    # Generate gradle wrapper if not exists
    if [ ! -f "gradlew" ]; then
        log_message "INFO" "Generating Gradle wrapper..."
        gradle wrapper --gradle-version 8.0.2
    fi
    
    # Make gradlew executable
    chmod +x gradlew
    
    # Clean previous builds
    log_message "INFO" "Cleaning previous builds..."
    ./gradlew clean
    
    # Build debug APK
    log_message "INFO" "Building debug APK..."
    ./gradlew assembleDebug
    
    # Build release APK
    log_message "INFO" "Building release APK..."
    ./gradlew assembleRelease
    
    # Copy APKs to output directory
    if [ -f "app/build/outputs/apk/debug/app-debug.apk" ]; then
        cp app/build/outputs/apk/debug/app-debug.apk "../$APK_OUTPUT_DIR/tapx-souls-debug.apk"
        log_message "SUCCESS" "Debug APK built: $APK_OUTPUT_DIR/tapx-souls-debug.apk"
    fi
    
    if [ -f "app/build/outputs/apk/release/app-release.apk" ]; then
        cp app/build/outputs/apk/release/app-release.apk "../$APK_OUTPUT_DIR/tapx-souls-release.apk"
        log_message "SUCCESS" "Release APK built: $APK_OUTPUT_DIR/tapx-souls-release.apk"
    fi
    
    cd ..
    log_message "SUCCESS" "Tapx-souls Android app build completed!"
}

# Function to setup Android environment
setup_android_environment() {
    log_message "INFO" "Setting up Android development environment..."
    
    # Set ANDROID_HOME if not set
    if [ -z "$ANDROID_HOME" ]; then
        export ANDROID_HOME="$HOME/android-sdk"
        echo "export ANDROID_HOME=\"$HOME/android-sdk\"" >> ~/.bashrc
    fi
    
    # Create SDK directory if it doesn't exist
    mkdir -p "$ANDROID_HOME"
    
    # Install Android SDK components if needed
    if [ ! -d "$ANDROID_HOME/platforms/android-33" ]; then
        log_message "WARNING" "Android SDK not found. Please install Android SDK manually."
    fi
}

# Function to create complete app structure
create_complete_app_structure() {
    log_message "INFO" "Creating complete Android app structure..."
    
    # Create missing activity files
    create_missing_activities
    
    # Create missing resource files
    create_missing_resources
    
    # Create ProGuard rules
    create_proguard_rules
}

# Function to create missing activities
create_missing_activities() {
    local activities_dir="android-app/app/src/main/java/com/tapxsouls/hackingtools/activities"
    mkdir -p "$activities_dir"
    
    # Create placeholder activities for all referenced activities
    local activity_names=(
        "WifiCrackerActivity"
        "PayloadGeneratorActivity" 
        "ExploitFrameworkActivity"
        "PacketSnifferActivity"
        "SqlInjectorActivity"
        "WebCrawlerActivity"
        "XssTesterActivity"
        "DirectoryBusterActivity"
        "PhishingKitActivity"
        "OsintGathererActivity"
        "CustomToolsActivity"
        "BackdoorGeneratorActivity"
        "CryptoCrackerActivity"
        "MobileForensicsActivity"
    )
    
    for activity in "${activity_names[@]}"; do
        if [ ! -f "$activities_dir/$activity.java" ]; then
            create_placeholder_activity "$activity" "$activities_dir"
        fi
    done
}

# Function to create placeholder activity
create_placeholder_activity() {
    local activity_name=$1
    local output_dir=$2
    
    cat > "$output_dir/$activity_name.java" << EOF
package com.tapxsouls.hackingtools.activities;

import android.os.Bundle;
import android.widget.TextView;
import androidx.appcompat.app.AppCompatActivity;
import com.tapxsouls.hackingtools.R;

public class $activity_name extends AppCompatActivity {
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        
        TextView textView = new TextView(this);
        textView.setText("🔧 $activity_name\\n\\nComing Soon...\\n\\nThis tool is under development.");
        textView.setTextColor(0xFF00FF41);
        textView.setBackgroundColor(0xFF0D1117);
        textView.setPadding(32, 32, 32, 32);
        textView.setTextSize(16);
        textView.setGravity(android.view.Gravity.CENTER);
        
        setContentView(textView);
    }
}
EOF
}

# Function to create ProGuard rules
create_proguard_rules() {
    cat > "android-app/app/proguard-rules.pro" << 'EOF'
# Add project specific ProGuard rules here.
# By default, the flags in this file are appended to flags specified
# in /usr/local/Cellar/android-sdk/24.3.3/tools/proguard/proguard-android.txt

-keep class com.tapxsouls.hackingtools.** { *; }
-keepclassmembers class * {
    public void *ButtonClicked(android.view.View);
}

# Ignore warnings
-dontwarn java.lang.invoke.*
-dontwarn **$$serializer
-dontwarn javax.annotation.**
EOF
}

# Setup compiler environment
setup_compiler_environment

# Create universal compiler
create_universal_compiler

# Build Android APK
build_android_apk() {
    log_message "INFO" "Building Tapx-souls Android APK..."
    
    if [ -d "android-app" ]; then
        cd android-app
        
        # Generate gradle wrapper if not exists
        if [ ! -f "gradlew" ]; then
            gradle wrapper
        fi
        
        # Build debug APK
        ./gradlew assembleDebug
        
        if [ -f "app/build/outputs/apk/debug/app-debug.apk" ]; then
            cp app/build/outputs/apk/debug/app-debug.apk ../tapx-souls-mobile.apk
            log_message "SUCCESS" "Android APK built successfully: tapx-souls-mobile.apk"
        else
            log_message "ERROR" "Failed to build Android APK"
        fi
        
        cd ..
    else
        log_message "WARNING" "Android app source not found, skipping APK build"
    fi
}

# Create custom exploit scripts
create_custom_exploits() {
    log_message "INFO" "Creating custom security scripts..."
    
    # Create network scanner script
    cat > "$HOME/tapx-souls/scripts/network_scanner.py" << 'EOF'
#!/usr/bin/env python3
"""
Tapx-souls Network Scanner
Simple network discovery and port scanning tool
"""
import socket
import threading
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

def ping_host(host):
    """Check if host is alive using ping"""
    try:
        result = subprocess.run(['ping', '-c', '1', '-W', '1', host], 
                              capture_output=True, text=True)
        return result.returncode == 0
    except:
        return False

def scan_port(host, port, timeout=1):
    """Scan a single port on target host"""
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        result = sock.connect_ex((host, port))
        sock.close()
        return result == 0
    except:
        return False

def scan_host(host, ports=None):
    """Scan multiple ports on a host"""
    if ports is None:
        ports = [21, 22, 23, 25, 53, 80, 110, 135, 139, 143, 443, 993, 995, 3389, 5432, 3306]
    
    print(f"Scanning {host}...")
    if not ping_host(host):
        print(f"Host {host} appears to be down")
        return
    
    open_ports = []
    with ThreadPoolExecutor(max_workers=50) as executor:
        futures = {executor.submit(scan_port, host, port): port for port in ports}
        for future in futures:
            port = futures[future]
            if future.result():
                open_ports.append(port)
    
    if open_ports:
        print(f"Open ports on {host}: {', '.join(map(str, open_ports))}")
    else:
        print(f"No open ports found on {host}")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python3 network_scanner.py <host>")
        sys.exit(1)
    
    target = sys.argv[1]
    scan_host(target)
EOF

    # Create WiFi scanner script  
    cat > "$HOME/tapx-souls/scripts/wifi_scanner.py" << 'EOF'
#!/usr/bin/env python3
"""
Tapx-souls WiFi Scanner
WiFi network discovery tool
"""
import subprocess
import re
import sys

def scan_wifi():
    """Scan for available WiFi networks"""
    try:
        # Try termux-wifi-scaninfo first (Termux-specific)
        result = subprocess.run(['termux-wifi-scaninfo'], 
                              capture_output=True, text=True)
        if result.returncode == 0:
            print("WiFi Networks Found:")
            print(result.stdout)
            return
    except FileNotFoundError:
        pass
    
    # Fallback methods
    print("WiFi scanning requires root access or termux-api")
    print("Install termux-api: pkg install termux-api")

if __name__ == "__main__":
    scan_wifi()
EOF

    # Create system info script
    cat > "$HOME/tapx-souls/scripts/system_info.py" << 'EOF'
#!/usr/bin/env python3
"""
Tapx-souls System Information Gatherer
"""
import subprocess
import os
import platform

def get_system_info():
    """Gather system information"""
    info = {}
    
    # Basic system info
    info['Platform'] = platform.platform()
    info['Architecture'] = platform.architecture()[0]
    info['Processor'] = platform.processor() or "Unknown"
    info['Python Version'] = platform.python_version()
    
    # Network info
    try:
        hostname = subprocess.check_output(['hostname']).decode().strip()
        info['Hostname'] = hostname
    except:
        info['Hostname'] = "Unknown"
    
    # Memory info
    try:
        with open('/proc/meminfo', 'r') as f:
            meminfo = f.read()
            for line in meminfo.split('\n'):
                if 'MemTotal' in line:
                    info['Total Memory'] = line.split()[1] + " kB"
                elif 'MemAvailable' in line:
                    info['Available Memory'] = line.split()[1] + " kB"
    except:
        info['Memory'] = "Unknown"
    
    return info

def display_info():
    """Display gathered information"""
    print("=" * 50)
    print("TAPX-SOULS SYSTEM INFORMATION")
    print("=" * 50)
    
    info = get_system_info()
    for key, value in info.items():
        print(f"{key:20}: {value}")
    
    print("=" * 50)

if __name__ == "__main__":
    display_info()
EOF

    # Make scripts executable
    chmod +x "$HOME/tapx-souls/scripts/"*.py
    
    # Create launcher script
    cat > "$HOME/tapx-souls/tapx-launcher.sh" << 'EOF'
#!/bin/bash
# Tapx-souls Security Tools Launcher

SCRIPT_DIR="$HOME/tapx-souls/scripts"

show_menu() {
    clear
    echo "╔══════════════════════════════════════╗"
    echo "║        TAPX-SOULS SECURITY SUITE     ║"
    echo "╚══════════════════════════════════════╝"
    echo ""
    echo "Available Tools:"
    echo "1) Network Scanner"
    echo "2) WiFi Scanner" 
    echo "3) System Information"
    echo "4) Exit"
    echo ""
    read -p "Select option [1-4]: " choice
}

while true; do
    show_menu
    case $choice in
        1)
            read -p "Enter target IP/hostname: " target
            python3 "$SCRIPT_DIR/network_scanner.py" "$target"
            read -p "Press Enter to continue..."
            ;;
        2)
            python3 "$SCRIPT_DIR/wifi_scanner.py"
            read -p "Press Enter to continue..."
            ;;
        3)
            python3 "$SCRIPT_DIR/system_info.py"
            read -p "Press Enter to continue..."
            ;;
        4)
            echo "Goodbye!"
            exit 0
            ;;
        *)
            echo "Invalid option"
            sleep 1
            ;;
    esac
done
EOF

    chmod +x "$HOME/tapx-souls/tapx-launcher.sh"
    
    # Create symlink for easy access
    ln -sf "$HOME/tapx-souls/tapx-launcher.sh" "$HOME/../usr/bin/tapx-souls"
    
    log_message "SUCCESS" "Custom security scripts created"
}

