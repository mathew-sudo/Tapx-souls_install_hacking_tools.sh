#!/data/data/com.termux/files/usr/bin/bash

# Tapx-souls Advanced Security Tools Installer
# Enhanced version with better error handling and logging

set -e
LOG_FILE="$HOME/tapx-souls-install.log"
TOOLS_INSTALLED=0
TOTAL_TOOLS=0

# Color codes for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Function to display banner
show_banner() {
    clear
    echo -e "${PURPLE}"
    figlet -f slant "TAPX-SOULS" 2>/dev/null || echo "TAPX-SOULS"
    echo -e "${NC}${CYAN}Advanced Termux Security Arsenal${NC}"
    echo -e "${YELLOW}=================================${NC}"
    echo ""
}

# Function to log messages
log_message() {
    local level=$1
    local message=$2
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$level] $message" >> "$LOG_FILE"
    
    case $level in
        "INFO")  echo -e "${BLUE}[INFO]${NC} $message" ;;
        "SUCCESS") echo -e "${GREEN}[SUCCESS]${NC} $message" ;;
        "WARNING") echo -e "${YELLOW}[WARNING]${NC} $message" ;;
        "ERROR") echo -e "${RED}[ERROR]${NC} $message" ;;
    esac
}

# Function to check if package is installed
is_installed() {
    pkg list-installed | grep -q "^$1/"
}

# Function to install package with error handling
install_package() {
    local package=$1
    local description=$2
    
    TOTAL_TOOLS=$((TOTAL_TOOLS + 1))
    
    if is_installed "$package"; then
        log_message "INFO" "$package is already installed"
        TOOLS_INSTALLED=$((TOOLS_INSTALLED + 1))
        return 0
    fi
    
    log_message "INFO" "Installing $package - $description"
    
    if pkg install -y "$package" >> "$LOG_FILE" 2>&1; then
        log_message "SUCCESS" "$package installed successfully"
        TOOLS_INSTALLED=$((TOOLS_INSTALLED + 1))
        return 0
    else
        log_message "ERROR" "Failed to install $package"
        return 1
    fi
}

