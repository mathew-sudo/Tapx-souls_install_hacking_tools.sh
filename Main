    # Generate strings.xml
    cat > "$res_dir/values/strings.xml" << EOF
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">$app_name</string>
    <string name="network_scanner">Network Scanner</string>
    <string name="wifi_cracker">WiFi Cracker</string>
    <string name="payload_generator">Payload Generator</string>
    <string name="exploit_framework">Exploit Framework</string>
