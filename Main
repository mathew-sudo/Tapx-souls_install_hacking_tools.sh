# Install terminal enhancements
log_message "INFO" "Installing terminal enhancements..."
install_package "figlet" "ASCII art text generator"
install_package "toilet" "Text display tool" "true"
install_package "cowsay" "Talking cow" "true"
install_package "bat" "Enhanced cat with syntax highlighting" "true"
install_package "exa" "Modern ls replacement" "true"

# Install Python packages for security tools
log_message "INFO" "Installing Python security packages..."
if command -v pip >/dev/null 2>&1; then
    pip install --upgrade pip >> "$LOG_FILE" 2>&1
    
    # Install common security Python packages
    python_packages=(
        "requests"
        "beautifulsoup4"
        "scapy"
