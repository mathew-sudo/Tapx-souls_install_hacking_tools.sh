    # Generate colors.xml
    cat > "$res_dir/values/colors.xml" << EOF
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="matrix_green">#00ff41</color>
    <color name="matrix_black">#0d1117</color>
    <color name="terminal_bg">#1a1a1a</color>
    <color name="danger_red">#ff4757</color>
    <color name="warning_yellow">#ffa502</color>
