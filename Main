# Create termux startup script
create_startup_script() {
    log_message "INFO" "Creating startup configuration..."
    
    cat > "$HOME/.bashrc_tapx" << 'EOF'
# Tapx-souls Security Environment
export PATH="$HOME/tapx-souls/scripts:$PATH"
export TAPX_HOME="$HOME/tapx-souls"

# Aliases
alias tapx-scan='python3 $HOME/tapx-souls/scripts/network_scanner.py'
alias tapx-wifi='python3 $HOME/tapx-souls/scripts/wifi_scanner.py'
alias tapx-info='python3 $HOME/tapx-souls/scripts/system_info.py'
alias tapx-launcher='$HOME/tapx-souls/tapx-launcher.sh'

# Welcome message
echo -e "\033[0;32m"
echo "TAPX-SOULS Security Environment Loaded"
echo "Type 'tapx-souls' to launch the security suite"
echo -e "\033[0m"
EOF

    # Add to bashrc if not already present
    if ! grep -q "source.*bashrc_tapx" "$HOME/.bashrc" 2>/dev/null; then
        echo "source ~/.bashrc_tapx" >> "$HOME/.bashrc"
    fi
    
    log_message "SUCCESS" "Startup configuration created"
}

create_startup_script

# Final cleanup and summary
cleanup_installation() {
    log_message "INFO" "Performing installation cleanup..."
    
    # Clean package cache
    pkg clean >> "$LOG_FILE" 2>&1
    
    # Set proper permissions
    chmod 700 "$HOME/tapx-souls"
    
    log_message "SUCCESS" "Installation cleanup completed"
}

cleanup_installation

